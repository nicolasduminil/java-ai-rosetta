<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>stacks</artifactId>
    <version>1.0.19</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>langchain4j-boot-parent</artifactId>
  <packaging>pom</packaging>
  <name>Java AI Rosetta :: Stacks :: LangChain4j on Spring Boot</name>
  <description>Parent for every NN-slug-langchain4j-boot module.</description>

  <properties>
    <!-- Keep method parameter names in the bytecode, so a tool's parameter names survive to the tool
         JSON schema instead of compiling to arg0, arg1, ... (The Quarkus parent sets the same flag.) -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-bom</artifactId>
        <version>${langchain4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <!-- LangChain4j's dedicated Spring Boot 4 starter, shared by every langchain4j-boot module (mirrors
           how spring-ai-boot-parent provides spring-ai-starter-model-ollama). It autoconfigures the
           OllamaChatModel from langchain4j.ollama.chat-model.* and brings langchain4j-ollama transitively.
           Its autoconfig is conditional (@ConditionalOnProperty / @ConditionalOnMissingBean), so a stack that
           sets no ollama properties or defines its own ChatModel (e.g. the OpenAI use case 08) is unaffected.
           Beta line, version managed by langchain4j-bom; the classic *-spring-boot-starter targets Boot 3. -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-ollama-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <!-- The JDK HTTP client is kept explicitly: hand-wired models (04's embedding, 08's OpenAI models)
           pin it via new JdkHttpClientBuilder() to avoid the SPI ambiguity with the starter's spring-restclient. -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-http-client-jdk</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          <systemPropertyVariables>
            <logging.level.org.springframework.web.servlet.mvc.support.DefaultHandlerExceptionResolver>ERROR</logging.level.org.springframework.web.servlet.mvc.support.DefaultHandlerExceptionResolver>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Classify the runnable (repackaged) jar as *-exec.jar so the plain classes jar stays the
               main artifact. That lets use case 03's evaluation modules depend on this application to
               boot it in-process, while build-image still containerises the runnable jar. -->
          <classifier>exec</classifier>
          <image>
            <name>${project.groupId}/${project.artifactId}:${project.version}</name>
          </image>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
