<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>spring-ai-boot-parent</artifactId>
    <version>1.0.19</version>
    <relativePath>../../../stacks/spring-ai-boot-parent/pom.xml</relativePath>
  </parent>

  <artifactId>10-security-spring-ai-boot</artifactId>
  <name>Java AI Rosetta :: 10 Security :: Spring AI on Spring Boot</name>
  <description>Securing a Spring AI assistant.</description>

  <properties>
    <ollama.model>qwen2.5:3b</ollama.model>
  </properties>

  <dependencies>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>10-security-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java-client-okhttp</artifactId>
      <version>4.39.1</version>
    </dependency>
    <!-- The OpenAI SDK (moderation) needs Jackson 2 databind at runtime, but Spring Boot 4.1 ships Jackson 3
         (tools.jackson.core), a different coordinate, and the only compile path to jackson-databind 2.x lands
         at test scope, so it is absent from the fat jar. Declare it explicitly so the runnable jar has it.
         Version is managed by the Boot BOM (2.21.4), matching the Jackson 2 core/annotations already present. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>10-security-common</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.smallrye</groupId>
      <artifactId>smallrye-jwt-common</artifactId>
      <version>4.6.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
