<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>spring-ai-boot-parent</artifactId>
    <version>1.0.14</version>
    <relativePath>../../../stacks/spring-ai-boot-parent/pom.xml</relativePath>
  </parent>

  <artifactId>10-security-spring-ai-boot</artifactId>
  <name>Java AI Rosetta :: 10 Security :: Spring AI on Spring Boot</name>
  <description>Securing a Spring AI assistant: JWT resource server, per-user vector-store filtering,
    a hand-written guardrail advisor, and an authorized tool.</description>

  <properties>
    <!-- Tool calling and reliable refusal need a capable model; qwen2.5:0.5b cannot emit tool calls. -->
    <ollama.model>qwen2.5:3b</ollama.model>
  </properties>

  <dependencies>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>10-security-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Content moderation uses Spring AI's OpenAiModerationModel (there is no local moderation model). It
         needs the OpenAI SDK's HTTP client, which spring-ai-openai does not pull on its own. Active only when
         OPENAI_API_KEY is set, so the stack stays local without a key. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java-client-okhttp</artifactId>
      <version>4.39.1</version>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>10-security-common</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- The conformance test (from the common test-jar) reads the PEM signing key with KeyUtils; test-scope
         deps do not travel with a test-jar, so smallrye-jwt-common is declared again here. -->
    <dependency>
      <groupId>io.smallrye</groupId>
      <artifactId>smallrye-jwt-common</artifactId>
      <version>4.6.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
