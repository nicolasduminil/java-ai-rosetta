<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>langchain4j-boot-parent</artifactId>
    <version>1.0.10</version>
    <relativePath>../../../stacks/langchain4j-boot-parent/pom.xml</relativePath>
  </parent>

  <artifactId>06-tools-langchain4j-boot</artifactId>
  <name>Java AI Rosetta :: 06 Tools :: LangChain4j on Spring Boot</name>
  <description>Tool-driven generation with a LangChain4j AI Service and tools registered via AiServices.tools.</description>

  <dependencies>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>06-tools-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
    </dependency>
    <dependency>
      <!-- LangChain4j's dedicated Spring Boot 4 starter (the classic langchain4j-ollama-spring-boot-starter
           targets Spring Boot 3 and does not work here). It autoconfigures the OllamaChatModel from
           langchain4j.ollama.chat-model.*, so this stack does not hand-wire it. Currently a beta line
           (version managed by langchain4j-bom); the other langchain4j-boot stacks still hand-wire until it
           goes stable. -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-ollama-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>06-tools-common</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <ollama.model>qwen2.5:3b</ollama.model>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
