<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>langchain4j-boot-parent</artifactId>
    <version>1.0.18</version>
    <relativePath>../../../stacks/langchain4j-boot-parent/pom.xml</relativePath>
  </parent>

  <artifactId>04-rag-classic-langchain4j-boot</artifactId>
  <name>Java AI Rosetta :: 04 RAG Classic :: LangChain4j on Spring Boot</name>
  <description>
    RAG classic implemented with LangChain4j on Spring Boot.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>4.22.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>04-rag-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-qdrant</artifactId>
    </dependency>
    <dependency>
      <!-- LangChain4j's dedicated Spring Boot 4 starter: it autoconfigures the OllamaChatModel from
           langchain4j.ollama.chat-model.*, so this stack no longer hand-wires it. The embedding model and
           vector store stay hand-wired (the starter covers the chat model only). Beta line, managed by the bom. -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-ollama-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-tika-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parser-pdf-module</artifactId>
      <version>3.3.2</version>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>04-rag-common</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
