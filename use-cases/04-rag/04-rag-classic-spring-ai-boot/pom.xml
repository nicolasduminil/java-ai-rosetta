<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.simplex-software.workshop</groupId>
    <artifactId>spring-ai-boot-parent</artifactId>
    <version>1.0.9</version>
    <relativePath>../../../stacks/spring-ai-boot-parent/pom.xml</relativePath>
  </parent>

  <artifactId>04-rag-classic-spring-ai-boot</artifactId>
  <name>Java AI Rosetta :: 04 RAG Classic :: Spring AI on Spring Boot</name>
  <description>
    RAG classic implemented with Spring AI on Spring Boot - Camel/Tika ingestion into Qdrant, imperative
    similarity-search retrieval.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>4.22.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>04-rag-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-tika-starter</artifactId>
    </dependency>
    <!-- camel-tika bundles only the html and text parser modules; add the PDF parser so Tika can
         extract our corpus. Version matches the tika-core that camel-tika 4.22.0 resolves. -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parser-pdf-module</artifactId>
      <version>3.3.2</version>
    </dependency>
    <dependency>
      <groupId>fr.simplex-software.workshop</groupId>
      <artifactId>04-rag-common</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
